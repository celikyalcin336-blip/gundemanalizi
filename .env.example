# Meta (Facebook & Instagram) API Bilgileri
# Meta for Developers (developers.facebook.com) üzerinden alınır.
META_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=

# Google Gemini API Anahtarı (İsteğe bağlı - boş bırakılırsa akıllı şablon kullanılır)
# https://aistudio.google.com/ üzerinden ücretsiz alınabilir.
GEMINI_API_KEY=

# Imgur Client ID (İsteğe bağlı - Instagram API görseli HTTPS link olarak ister)
IMGUR_CLIENT_ID=

# Test / Simülasyon Modu:
# True  -> Gerçek paylaşım yapmaz, sadece görseli ve metni yerel olarak üretip test eder.
# False -> Canlı olarak Facebook ve Instagram'a gönderir.
DRY_RUN=True

# Otomatik döngü kontrol aralığı (dakika)
CHECK_INTERVAL_MINUTES=15
